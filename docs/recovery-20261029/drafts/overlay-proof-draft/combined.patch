+double Percentile(QVector<double> values, double p)
+{
+    if (values.isEmpty()) {
+        return 0.0;
+    }
+    std::sort(values.begin(), values.end());
+    const int index = std::clamp(static_cast<int>(std::ceil(p * values.size())) - 1, 0,
+                                 static_cast<int>(values.size()) - 1);
+    return values[index];
+}
