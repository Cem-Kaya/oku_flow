# Optional, runtime-loaded OCR adapters. No network access during configuration.
option(OKUFLOW_UCT_REQUIRE_PADDLE_CPU "Require CPU Paddle adapter headers instead of a Windows-only fallback build" OFF)
option(OKUFLOW_UCT_REQUIRE_TENSORRT "Require TensorRT adapter headers and CUDA" OFF)
function(okuflow_configure_ocr target)
    include("${PROJECT_SOURCE_DIR}/cmake/MathRender.cmake")
    target_link_libraries(${target} PRIVATE okuflow_math_typesetter)
    get_target_property(ocr_sources ${target} SOURCES)
    if(NOT "${PROJECT_SOURCE_DIR}/src/common/uct_formula.cpp" IN_LIST ocr_sources)
        target_sources(${target} PRIVATE "${PROJECT_SOURCE_DIR}/src/common/uct_formula.cpp")
    endif()
    if(NOT "${PROJECT_SOURCE_DIR}/src/common/uct_formula_image.cpp" IN_LIST ocr_sources)
        target_sources(${target} PRIVATE "${PROJECT_SOURCE_DIR}/src/common/uct_formula_image.cpp")
    endif()
    foreach(source IN ITEMS uct_formula_layout uct_formula_workflow)
        if(NOT "${PROJECT_SOURCE_DIR}/src/common/${source}.cpp" IN_LIST ocr_sources)
            target_sources(${target} PRIVATE "${PROJECT_SOURCE_DIR}/src/common/${source}.cpp")
        endif()
    endforeach()
    target_compile_definitions(${target} PRIVATE OKUFLOW_ENABLE_CUDA=$<BOOL:${OKUFLOW_ENABLE_CUDA}>)
    set(OKUFLOW_UCT_SDK_ROOT "$ENV{LOCALAPPDATA}/OkuFlow/ocr-deps" CACHE PATH "Private pinned OCR development SDK cache")
    set(ort_headers "${OKUFLOW_UCT_SDK_ROOT}/onnxruntime-win-x64-1.31.0/onnxruntime-win-x64-1.31.0/include")
    if(EXISTS "${ort_headers}/onnxruntime_cxx_api.h")
        target_include_directories(${target} PRIVATE "${ort_headers}")
        target_compile_definitions(${target} PRIVATE OKUFLOW_UCT_ORT=1)
    else()
        if(OKUFLOW_UCT_REQUIRE_PADDLE_CPU)
            message(FATAL_ERROR "Required ONNX Runtime CPU headers are missing; prepare the pinned OCR SDK first")
        endif()
        target_compile_definitions(${target} PRIVATE OKUFLOW_UCT_ORT=0)
        message(STATUS "${target}: Paddle CPU SDK absent; Windows OCR remains available")
    endif()
    set(OKUFLOW_UCT_TENSORRT_ROOT "${OKUFLOW_UCT_SDK_ROOT}/TensorRT-11.4.0.106-cuda12.9/TensorRT-11.4.0.106" CACHE PATH "Optional TensorRT 11.4 CUDA 12.9 SDK")
    if(OKUFLOW_ENABLE_CUDA AND EXISTS "${OKUFLOW_UCT_TENSORRT_ROOT}/include/NvInfer.h")
        target_include_directories(${target} PRIVATE "${OKUFLOW_UCT_TENSORRT_ROOT}/include")
        target_compile_definitions(${target} PRIVATE OKUFLOW_UCT_TRT=1)
    else()
        if(OKUFLOW_UCT_REQUIRE_TENSORRT)
            message(FATAL_ERROR "Required TensorRT headers or CUDA support are missing")
        endif()
        target_compile_definitions(${target} PRIVATE OKUFLOW_UCT_TRT=0)
    endif()
endfunction()
