{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "msvc-base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "C:/Qt/6.9.3/msvc2022_64"
      }
    },
    {
      "name": "msvc-debug",
      "displayName": "MSVC Debug (CUDA)",
      "inherits": "msvc-base",
      "binaryDir": "${sourceDir}/build/msvc-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "OPENZOOM_ENABLE_CUDA": "ON",
        "OPENZOOM_ENABLE_TEXT_SR": "ON",
        "OPENZOOM_ENABLE_TESTS": "OFF",
        "CMAKE_CUDA_ARCHITECTURES": "75;86;89"
      }
    },
    {
      "name": "msvc-release",
      "displayName": "MSVC Release (CUDA)",
      "inherits": "msvc-base",
      "binaryDir": "${sourceDir}/build/msvc-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "OPENZOOM_ENABLE_CUDA": "ON",
        "OPENZOOM_ENABLE_TEXT_SR": "ON",
        "OPENZOOM_ENABLE_TESTS": "OFF",
        "CMAKE_CUDA_ARCHITECTURES": "75;86;89"
      }
    },
    {
      "name": "msvc-cpu",
      "displayName": "MSVC Release Tests (CPU only)",
      "inherits": "msvc-base",
      "binaryDir": "${sourceDir}/build/msvc-cpu",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "OPENZOOM_ENABLE_CUDA": "OFF",
        "OPENZOOM_ENABLE_TEXT_SR": "OFF",
        "OPENZOOM_ENABLE_TESTS": "ON"
      }
    },
    {
      "name": "msvc-cuda-tests",
      "displayName": "MSVC Release (CUDA + tests)",
      "inherits": "msvc-base",
      "binaryDir": "${sourceDir}/build/msvc-cuda-tests",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "OPENZOOM_ENABLE_CUDA": "ON",
        "OPENZOOM_ENABLE_TEXT_SR": "OFF",
        "OPENZOOM_ENABLE_TESTS": "ON",
        "CMAKE_CUDA_ARCHITECTURES": "75;86;89"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "msvc-debug-build",
      "configurePreset": "msvc-debug"
    },
    {
      "name": "msvc-release-build",
      "configurePreset": "msvc-release"
    },
    {
      "name": "msvc-cpu-build",
      "configurePreset": "msvc-cpu"
    },
    {
      "name": "msvc-cuda-tests-build",
      "configurePreset": "msvc-cuda-tests"
    }
  ],
  "testPresets": [
    {
      "name": "msvc-cpu-tests",
      "configurePreset": "msvc-cpu",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "msvc-cuda-tests",
      "configurePreset": "msvc-cuda-tests",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
