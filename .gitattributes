# check_translations.ps1 requires LF catalogs regardless of core.autocrlf.
translations/*.ts text eol=lf
src/ui/translation_catalog.cpp text eol=lf
android/gradlew text eol=lf
# Reviewed upstream evidence and packaged notices are hashed as original bytes.
android/app/src/main/assets/licenses/** -text whitespace=cr-at-eol,-blank-at-eof
android/licenses/** -text whitespace=cr-at-eol,-blank-at-eof
scripts/vc-runtime/LICENSE.rtf -text -diff
scripts/build_release_bundle.bat text eol=crlf
scripts/windows-installer/WIX_LICENSE.txt -text
third_party/paddleocr/LICENSE -text
