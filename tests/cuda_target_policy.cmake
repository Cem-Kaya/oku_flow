include("${CMAKE_CURRENT_LIST_DIR}/../cmake/CudaTargets.cmake")
foreach(version IN ITEMS 12.9 12.9.86 13.0 13.4.92)
    okuflow_select_cuda_architectures("${version}" actual)
    set(expected 75 80 86 89 90 100 103 120 121)
    if(version VERSION_LESS 13.0)
        list(PREPEND expected 61)
    endif()
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Incorrect CUDA ${version} architecture policy: ${actual}")
    endif()
endforeach()
