#include <windows.h>

// Test-only VERSIONINFO. The legacy recovery tests copy this fixture as the
// bundle launcher (oku_flow.exe) and pin this exact ProductName through the
// helper's provenance seam; production expectations stay pinned separately.
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "OkuFlow legacy adb test fixture"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "adb_legacy_fixture"
            VALUE "OriginalFilename", "adb_legacy_fixture.exe"
            VALUE "ProductName", "OkuFlow Legacy Fixture"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
